.claude/
.env
.env.local

# Upstream testbed clone - reference only, nothing builds from it
# (Sock Shop images are pulled pre-built from Docker Hub). Has its own
# .git history, so it doesn't belong nested inside this repo. Re-clone
# with: git clone https://github.com/microservices-demo/microservices-demo testbed/sock-shop
testbed/

# Java / Maven build artifacts inside testbed services
**/target/

# Python cache and test artifacts
**/__pycache__/
*.py[cod]
.pytest_cache/
# Local virtualenvs. The services install their own requirements in their images; a venv is
# only ever a convenience for running a service's tests on the host.
.venv/
.venv-host/
venv/

# Evaluation output. Regenerable from a single command, and a committed run
# would go stale immediately - quote numbers in the report, don't version them.
results/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db
